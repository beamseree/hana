#!/bin/bash
set -euo pipefail
cd "$(dirname "$0")/.."
xcrun swift build -c release
app="$PWD/build/Hana.app"
mkdir -p "$app/Contents/MacOS"
cp App/Info.plist "$app/Contents/Info.plist"
cp "$(xcrun swift build -c release --show-bin-path)/Hana" "$app/Contents/MacOS/Hana"
/usr/bin/plutil -lint "$app/Contents/Info.plist"
/usr/bin/codesign --force --sign - --identifier com.beamseree.hana "$app"
/usr/bin/codesign --verify --deep --strict --verbose=2 "$app"
echo "$app"
