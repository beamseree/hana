#!/usr/bin/env python3
"""Summarize content-free --validate-performance JSONL; never infer physical focus."""
import json
import math
import statistics
import sys
from pathlib import Path

rows = [json.loads(line) for line in Path(sys.argv[1]).read_text().splitlines()]
complete = {row['run'] for row in rows if row['event'] == 'performance.complete'}
rows = [row for row in rows if row.get('run') in complete]

def describe(values):
    values = sorted(values)
    return {'n': len(values), 'median': statistics.median(values),
            'p95_nearest_rank': values[math.ceil(len(values) * .95) - 1],
            'max': max(values)} if values else {'n': 0}

output = {'complete_runs': len(complete), 'units': 'milliseconds', 'groups': {}}
for event, cold_key, fields in [
    ('performance.integrated', 'coldProcessSample', [
        'presentationCallMilliseconds', 'nativeInsertionCallMilliseconds',
        'firstAppObservedMilliseconds', 'firstFileObservedMilliseconds']),
    ('performance.local', 'freshCatalog', ['milliseconds']),
]:
    for cold in (True, False):
        samples = [r for r in rows if r['event'] == event and r[cold_key] == cold]
        output['groups'][event + ('.cold' if cold else '.warm')] = {
            'attempts': len(samples),
            'invalid_contexts': sum(not r.get('contextIntact', True) for r in samples),
            **{field: describe([r[field] for r in samples if field in r and r.get('contextIntact', True)])
               for field in fields},
        }
values = [v for r in rows if r['event'] == 'performance.scheduling' for v in r['excessMilliseconds']]
output['scheduling_excess'] = {**describe(values), 'over_50ms': sum(v > 50 for v in values)}
print(json.dumps(output, indent=2))
