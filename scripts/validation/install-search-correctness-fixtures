#!/bin/bash
set -euo pipefail
# Only disposable synthetic files for the opt-in #7 Search regression/demo.
python3 - <<'PY'
from pathlib import Path
root = Path.home() / 'Hana Issue 7 Validation'
root.mkdir(exist_ok=True)
fixtures = {f'[ {n:04} Hana7 *].txt': 'Synthetic issue 7 candidate.\n' for n in range(2100)}
fixtures['[Hana7*].txt'] = 'Hana issue 7 exact destination.\n'
fixtures['Hana7 Note.txt'] = 'Hana issue 7 native destination validation.\nType here to verify destination focus.\n'
